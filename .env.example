DASHSCOPE_API_KEY=sk-your-bailian-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_JUDGE_MODEL=qwen3.6-plus
PIXVERSE_API_KEY=your-pixverse-api-key
PIXVERSE_BASE_URL=https://app-api.pixverse.ai
PIXVERSE_VIDEO_MODEL=v6
PIXVERSE_VIDEO_DURATION=8
PIXVERSE_VIDEO_QUALITY=720p
# PixVerse CLI is enabled by default. Install and login first:
# npm install -g pixverse
# pixverse auth login
# pixverse account info
PIXVERSE_CLI_BIN=pixverse
#
# Default image command:
# {pixverse} create image --prompt {prompt} --images {referenceImages} --model seedream-4.5 --quality 2160p --aspect-ratio 16:9 --json
#
# Default video command:
# {pixverse} create video --prompt {prompt} --image {inputImage} --model v6 --quality 1080p --duration 8 --json
#
# Optional overrides. Placeholders are shell-quoted automatically:
# {pixverse}, {promptFile}, {prompt}, {outputDir}, {outputImage}, {arenaImage}, {referenceImages}
# {inputImage}, {outputVideo}, {winnerSide}
PIXVERSE_CLI_IMAGE_COMMAND=
PIXVERSE_CLI_VIDEO_COMMAND=
PIXVERSE_CLI_TIMEOUT_MS=1200000
PIXVERSE_CLI_DISABLED=0
REQUIRE_REAL_GENERATION=1
PORT=8787
HOST=127.0.0.1
